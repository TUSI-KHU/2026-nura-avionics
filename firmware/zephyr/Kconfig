mainmenu "NURA Zephyr avionics"

config NURA_FAKE_PSP
    bool "Use deterministic fake platform"
    default y if BOARD_NATIVE_SIM
    default n
    help
      Bench/native_sim only. Never enable this in a flight image.

config NURA_TRACE_CONSOLE
    bool "Export TraceMap records to console"
    default n

config NURA_BOARD_SETTLE_MS
    int "Board power and bus settle delay"
    range 0 30000
    default 0 if NURA_FAKE_PSP
    default 5250

config NURA_TRACE_CAPACITY_RECORDS
    int "TraceMap retained records"
    range 128 8192
    default 2048 if BOARD_NATIVE_SIM
    default 512

config NURA_TRACE_EXPORT_BATCH_RECORDS
    int "Trace exporter batch records"
    range 16 512
    default 128

config NURA_COMMAND_QUEUE_SLOTS
    int
    default 9

config NURA_ACTUATION_QUEUE_SLOTS
    int
    default 17

config NURA_TRANSITION_QUEUE_SLOTS
    int
    default 17

config NURA_DECISION_QUEUE_SLOTS
    int
    default 65

config NURA_SENSOR_FAULT_QUEUE_SLOTS
    int
    default 9

source "Kconfig.zephyr"
